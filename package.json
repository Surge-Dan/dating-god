{
  "name": "dating-god-quality",
  "private": true,
  "scripts": {
    "test": "node --test tests",
    "test:e2e": "playwright test && node qa/browser-coverage.cjs",
    "test:features": "cucumber-js qa/features --require qa/steps.cjs",
    "test:mutation": "stryker run",
    "check": "node qa/check.cjs",
    "test:coverage": "c8 --all --include=dating-god/scripts/** --include=dating-god/assets/engine.js --include=dating-god/assets/report.js --check-coverage --lines=85 --branches=75 node --test tests"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@cucumber/cucumber": "13.3.0",
    "@stryker-mutator/core": "10.1.1",
    "c8": "12.0.0",
    "@axe-core/playwright": "4.14.0",
    "@phosphor-icons/core": "2.1.1",
    "v8-to-istanbul": "9.3.0",
    "istanbul-lib-coverage": "3.2.2"
  }
}
